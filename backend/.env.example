# AeroMint Backend Environment Variables Template
# -----------------------------------------------
PORT=3001
NODE_ENV=production

# Official OpenSea API Key (Hidden from frontend clients)
OPENSEA_API_KEY=5f32ee9b98e84ea184a514f975ad4f3f

# Blockchain Explorer API Keys (Optional, for higher rate limits)
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=

# Allowed CORS Origins (Comma-separated, e.g. https://aeromint.vercel.app,http://localhost:5173)
CORS_ORIGIN=*
